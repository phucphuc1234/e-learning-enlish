{
  "name": "english-learning-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "seed:demo": "node --env-file-if-exists=.env server/seed.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test tests/api.test.js",
    "test:e2e": "playwright test",
    "format:check": "prettier --check server scripts src tests vite.config.js playwright.config.js"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "chart.js": "^4.4.1",
    "date-fns": "^3.3.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
