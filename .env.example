PORT=5000
HOST=127.0.0.1
DB_DRIVER=mssql
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=ELearningEnglish_Demo
DB_USER=sa
DB_PASSWORD="REPLACE_WITH_YOUR_LOCAL_SQL_SERVER_PASSWORD"
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Optional named instance instead of fixed port: DB_INSTANCE=SQLEXPRESS
# DATABASE_PATH is used only when DB_DRIVER=sqlite; never used as SQL fallback.
DATABASE_PATH=.data/english.sqlite
NODE_ENV=development
# Production: create the first administrator with npm run admin:create.
# npm run seed:demo is for SQLite development only; SQL data comes from EnglishStudio_Full.sql.
